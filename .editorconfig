root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown: dos espacios al final de una línea son un salto de línea
[*.md]
trim_trailing_whitespace = false

# Scripts de Windows
[*.{cmd,bat}]
end_of_line = crlf

# El pom.xml generado por Spring Initializr usa tabulaciones
[pom.xml]
indent_style = tab
